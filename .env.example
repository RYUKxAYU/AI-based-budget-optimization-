# =============================================================================
# .env.example — AI Based Green Budget Optimizer
# Copy this to .env and fill in real values.
# NEVER commit your real .env to version control.
# =============================================================================

# ─── Database ─────────────────────────────────────────────────────────────────
# Use PostgreSQL for production (SQLite for local dev only)
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5433/AQIDB
# DATABASE_URL=sqlite:///./data/app.db   # local dev only

# ─── Authentication ───────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET_KEY=your_generated_secret_key_here
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# ─── Application ──────────────────────────────────────────────────────────────
APP_ENV=development        # development | production
LOG_LEVEL=INFO             # DEBUG | INFO | WARNING | ERROR

# ─── Service Ports ────────────────────────────────────────────────────────────
API_PORT=8000
AUTH_SERVICE_PORT=8001
DATA_SERVICE_PORT=8002
MODEL_SERVICE_PORT=8003
OPTIMIZATION_SERVICE_PORT=8004
FRONTEND_PORT=3000

# ─── ML Model ─────────────────────────────────────────────────────────────────
MODEL_PATH=green_budget_optimizer/outputs/aqi_forest_model.pkl
ENABLE_SHAP=false
ENABLE_BAYESIAN_OPT=false
RANDOM_SEED=42

# ─── Data ─────────────────────────────────────────────────────────────────────
DATA_SOURCE=synthetic      # synthetic | real
OPENAQ_API_KEY=            # Get free key at https://openaq.org/register

# ─── PostgreSQL (Docker) ──────────────────────────────────────────────────────
POSTGRES_USER=budget_user
POSTGRES_PASSWORD=budget_pass
POSTGRES_DB=AQIDB
