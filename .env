# =============================================================================
# AI Budget Optimizer — Environment Variables
# =============================================================================
# Copy this file to .env and fill in real values.
# NEVER commit the real .env to version control.
# =============================================================================

# ─── Database ─────────────────────────────────────────────────────────────────
# Phase 1: SQLite (local file). Phase 2+: swap to PostgreSQL URL below.
DATABASE_URL=sqlite:///./data/app.db
# DATABASE_URL=postgresql://user:password@localhost:5432/budget_optimizer

# ─── Authentication ───────────────────────────────────────────────────────────
JWT_SECRET_KEY=change_me_to_a_long_random_secret_string_in_production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# ─── Service Ports ────────────────────────────────────────────────────────────
AUTH_SERVICE_PORT=8001
DATA_SERVICE_PORT=8002
MODEL_SERVICE_PORT=8003
OPTIMIZATION_SERVICE_PORT=8004
FRONTEND_PORT=3000

# ─── Model ────────────────────────────────────────────────────────────────────
MODEL_PATH=services/model-service/models/aqj_forest_model.pkl

# ─── Data ─────────────────────────────────────────────────────────────────────
DATA_SOURCE=synthetic
OPENAQ_API_KEY=your_openaq_api_key_here

# ─── Feature flags ────────────────────────────────────────────────────────────
ENABLE_SHAP=false
ENABLE_BAYESIAN_OPT=false
