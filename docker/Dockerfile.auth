# Dockerfile.auth — Auth Service
FROM python:3.12-slim

WORKDIR /app

RUN pip install --no-cache-dir \
    fastapi==0.111.0 \
    uvicorn[standard]==0.29.0 \
    sqlalchemy==2.0.30 \
    psycopg2-binary==2.9.9 \
    python-jose[cryptography]==3.3.0 \
    passlib[bcrypt]==1.7.4 \
    python-dotenv==1.0.1 \
    pydantic==2.7.1

# Copy shared DB layer and service code
COPY shared/ ./shared/
COPY .env .env

ENV PYTHONPATH=/app
EXPOSE 8001

# Placeholder entrypoint — replace with actual FastAPI app module
CMD ["uvicorn", "services.auth.main:app", "--host", "0.0.0.0", "--port", "8001"]
